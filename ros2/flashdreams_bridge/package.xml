<package format="3">
  <name>flashdreams_bridge</name>
  <version>0.1.0</version>
  <description>Translate Interactive Drive observations and lockstep commands to ROS 2.</description>
  <maintainer email="maintainers@users.noreply.github.com">FlashDreams contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>flashdreams_interfaces</exec_depend>
