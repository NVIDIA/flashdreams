ARG FLASHDREAMS_BASE_IMAGE=flashdreams-base:local
FROM ${FLASHDREAMS_BASE_IMAGE}

WORKDIR /workspace/flashdreams

COPY . /workspace/flashdreams

RUN test -f pyproject.toml
RUN uv sync --locked --package flashdreams-omnidreams

WORKDIR /workspace/flashdreams
