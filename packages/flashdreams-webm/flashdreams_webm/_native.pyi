class Writer:
    width: int
    height: int
    def __init__(
        self,
        path: str,
        width: int,
        height: int,
        fps_numerator: int,
        fps_denominator: int,
    ) -> None: ...
    def write(self, pixels: bytes) -> None: ...
    def write_rgb(self, pixels: object) -> None: ...
    def close(self) -> None: ...
    def abort(self) -> None: ...

class Reader:
    width: int
    height: int
    duration_ns: int
    def __init__(self, path: str) -> None: ...
    def read(self) -> tuple[bytes, bytes, bytes] | None: ...
    def close(self) -> None: ...
